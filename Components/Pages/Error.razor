
@page "/Error"
@page "/Error/{StatusCode:int}"

@using Microsoft.AspNetCore.Authorization

@attribute [AllowAnonymous]

<PageTitle>@Title - ReviewDeck</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">

            <h1 class="display-5 fw-bold">@Title</h1>

            <p class="lead mt-3">@Message</p>

            <p class="text-secondary">
                Error code: @EffectiveStatusCode
            </p>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/" class="btn btn-primary">
                    Go to home
                </a>

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="GoBack">
                    Go back
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public int? StatusCode { get; set; }

    private int EffectiveStatusCode => StatusCode ?? 500;

    private string Title => EffectiveStatusCode switch
    {
        400 => "Bad request",
        401 => "Sign in required",
        403 => "Access denied",
        404 => "Page not found",
        405 => "Method not allowed",
        408 => "Request timed out",
        409 => "Request conflict",
        429 => "Too many requests",
        >= 500 => "Something went wrong",
        _ => "Unable to complete your request"
    };

    private string Message => EffectiveStatusCode switch
    {
        400 => "The request could not be processed. Check your input and try again.",
        401 => "Please sign in to access this resource.",
        403 => "You don't have permission to access this resource.",
        404 => "We couldn't find the page you're looking for. It may have moved or no longer exist.",
        405 => "This action isn't supported for this address.",
        408 => "The request took too long. Please try again.",
        409 => "The request conflicts with the current state. Refresh the page and try again.",
        429 => "You've made too many requests. Please wait before trying again.",
        >= 500 => "An unexpected server error occurred. Please try again later.",
        _ => "We couldn't complete your request. Please try again."
    };

    private void GoBack()
    {
        // Navigate to a known route rather than relying on browser history.
        NavigationManager.NavigateTo("/");
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
