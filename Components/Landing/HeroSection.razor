
<section class="hero-bento" aria-labelledby="hero-title">
    <article class="hero-bento-main">
        <img class="hero-bento-main-image"
             src="/image/landing/job-search-hero.webp"
             alt="Professional reviewing job opportunities on a laptop"
             fetchpriority="high"
             width="1200"
             height="800" />

        <div class="hero-bento-main-content">
            <p class="hero-eyebrow">YOUR CAREER, ORGANIZED</p>

            <h1 id="hero-title">Master Your Job Search</h1>

            <p class="hero-description">
                Organize, track, and manage your applications
                as you work toward your next opportunity.
            </p>

            <a class="landing-button" href="/register">
                Create Your Application Hub
            </a>
        </div>
    </article>

    <div class="hero-bento-side">
        <article class="hero-bento-card">
            <img src="/image/landing/job-search-mobile.webp"
                 alt="Job seeker reviewing an opportunity on a tablet"
                 width="800"
                 height="500"
                 loading="lazy"
                 decoding="async" />

            <div class="hero-bento-card-overlay">
                <h2>Stay on Top of Opportunities</h2>
            </div>
        </article>

        <article class="hero-bento-card">
            <img src="/image/landing/job-search-workspace.webp"
                 alt="Professionals reviewing information together at a computer"
                 width="800"
                 height="500"
                 loading="lazy"
                 decoding="async" />

            <div class="hero-bento-card-overlay">
                <h2>Keep Your Search Organized</h2>
            </div>
        </article>
    </div>
</section>
